# ── Banco de dados ────────────────────────────────────────────────────────────
# SQLite local (desenvolvimento):
DATABASE_URL=sqlite:///./lead_enricher.db
# PostgreSQL (producao):
# DATABASE_URL=postgresql://user:password@host:5432/lead_enricher

# ── Ambiente ──────────────────────────────────────────────────────────────────
# "production" fecha /docs, /redoc e /openapi.json, faz o app falhar no boot se
# o schema do banco nao subir e exige chave de autenticacao configurada.
# APP_ENV=production

# ── Supabase Auth ─────────────────────────────────────────────────────────────
# Encontrado em: Supabase Dashboard > Settings > API > JWT Secret.
# OBRIGATORIO para login real: com a variavel ausente (ou com menos de 32
# caracteres) o app RECUSA qualquer JWT — antes ele aceitava token assinado com
# string vazia, o que permitia a qualquer pessoa assumir qualquer conta.
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ── Modo demonstracao ─────────────────────────────────────────────────────────
# Ligado por padrao: qualquer visitante recebe uma sessao efemera (por
# navegador) no plano Pro, sem cadastro, para explorar o produto inteiro.
# Assinatura fica bloqueada nessa sessao — pagar exige conta de verdade.
# DEIXE COMO ESTA enquanto o projeto for local/demonstracao; ao abrir para
# clientes pagantes, defina DEMO_MODE=0.
# DEMO_MODE=1

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_ENTERPRISE=price_...

# ── App ───────────────────────────────────────────────────────────────────────
# URL base da aplicacao (usado nos redirects do Stripe Checkout)
APP_URL=http://localhost:8000

# ── SEO ───────────────────────────────────────────────────────────────────────
# Dominio canonico do site, sem barra final. Alimenta <link rel="canonical">,
# og:url, sitemap.xml e robots.txt. Sem ele, cai na origem da requisicao — o que
# gera conteudo duplicado quando o mesmo site responde no dominio proprio e no
# *.vercel.app. Definir em producao.
# SITE_URL=https://leadenricher.app

# ── Scraping e desempenho ─────────────────────────────────────────────────────
# Timeout em segundos para requests HTTP de scraping (padrao: 15)
SCRAPING_TIMEOUT=15
# Timeout das paginas internas (/sobre, /contato) — padrao: 6
# SCRAPING_INNER_TIMEOUT=6
# Teto de tempo do conjunto de paginas internas — padrao: 10
# SCRAPING_INNER_BUDGET=10
# Teto de tempo da busca inteira. A funcao serverless da Vercel morre em 60 s;
# com este orcamento devolvemos ficha parcial em vez de perder tudo. Padrao: 35
# ENRICH_BUDGET_SECONDS=35
# Consulta WHOIS/RDAP (ASN, rede e pais de cada IP). Padrao: 4 s por lookup
# WHOIS_TIMEOUT=4
# Quantos servidores MX ganham linha completa (IP, PTR, ASN, rede, pais)
# no painel de infraestrutura de e-mail. Padrao: 4
# MX_DETAIL_MAX=4

# Teto de tempo da busca de decisores (/api/decisores). A funcao serverless
# morre em 60 s; sem esse limite a cascata de motores de busca passava disso e
# a requisicao inteira se perdia. Padrao: 30
# DECISORES_BUDGET_SECONDS=30

# ── Verificacao de e-mail (SMTP) ──────────────────────────────────────────────
# A sondagem SMTP confirma se a caixa existe, sem enviar mensagem. Ambientes
# serverless costumam bloquear a porta 25 — com SMTP_PROBE=0 a checagem e
# pulada e a confianca passa a vir do padrao aprendido do dominio.
# SMTP_PROBE=0
# SMTP_TIMEOUT=5
# SMTP_PROBE_FROM=verify@seudominio.com.br

# ── Integracoes opcionais (fases 4-5 — sem as chaves, endpoints respondem 503) ─
# IA: resumo executivo e roteiro de ligacao via Claude API
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Libera IA no plano free (apenas dev/teste):
# AI_ALLOW_FREE=1

# CRM via webhook assinado (Zapier/Make/n8n/Power Automate -> Dynamics etc.)
# CRM_WEBHOOK_URL=https://hooks.exemplo.com/leadenricher
# CRM_WEBHOOK_SECRET=segredo-do-hmac

# Verificacao premium de e-mail (enhancer sobre a pipeline SMTP gratuita)
# HUNTER_API_KEY=...

# ── E-mail transacional (confirmacao de opt-out LGPD) ─────────────────────────
# Sem chave, o pedido de remocao fica registrado como PENDENTE e o link de
# confirmacao vai para o log do servidor (suficiente em desenvolvimento).
# Em producao, configure para que o titular receba o link.
# RESEND_API_KEY=re_...
# MAIL_FROM=LeadEnricher <nao-responda@seudominio.com.br>

# ── Extensao de navegador ─────────────────────────────────────────────────────
# IDs de extensao autorizados a chamar a API (lista separada por virgula).
# Sem a variavel, qualquer extensao Chrome pode chamar — o que so e aceitavel
# antes da publicacao na Web Store, quando o ID ainda muda a cada carga local.
# EXTENSION_IDS=abcdefghijklmnopabcdefghijklmnop
